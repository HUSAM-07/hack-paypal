# CITED configuration. Every value below is a placeholder; real values never get committed.
#
# The defaults run the whole stack with NO keys: PayPal is simulated in-process and the
# shopper agents are scripted. Nothing needs to be set to try CITED.
#
# Usage: the apps read process.env, they do not load this file themselves. Either export the
# variables you change, or run a command through Node's loader:
#   node --env-file=.env <command>
# The engine (a Cloudflare Worker) reads apps/engine/.dev.vars instead; see
# apps/engine/.dev.vars.example.

# --- Modes ----------------------------------------------------------------------------------
# simulated (default): in-memory PayPal mock, no keys. sandbox: real PayPal sandbox calls,
# needs the credentials below. `npm run dev:cited` always forces simulated; to use sandbox run
# one app, e.g. `PAYPAL_MODE=sandbox npm run dev -w @cited/catalogue-mcp`.
PAYPAL_MODE=simulated
# fake (default): scripted shopper agents, no network. Any other value: call the LLM gateway.
MODEL_PROVIDER=fake

# --- PayPal sandbox (only when PAYPAL_MODE=sandbox) -----------------------------------------
# From developer.paypal.com > Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook subscription id. Used by the engine to verify webhook signatures (set it in
# apps/engine/.dev.vars; required there unless PAYPAL_MODE=simulated).
PAYPAL_WEBHOOK_ID=

# --- Agent Affiliate Passport signing key ---------------------------------------------------
# One shared secret, e.g. `openssl rand -base64 32`. Two apps read it under two names; give
# both the same value. In simulated mode the catalogue falls back to a built-in dev key.
# apps/catalogue-mcp: signs passports, and checks them before checkout puts one in custom_id
PASSPORT_SIGNING_KEY=
# apps/engine: verifies before crediting (set it in apps/engine/.dev.vars)
PASSPORT_KEY=

# --- Agent checkout through PayPal (only when PAYPAL_MODE=sandbox) ---------------------------
# See cited/spec/AGENT-CHECKOUT.md. The buyer's PayPal wallet, vaulted once for the agent
# (payment_source.paypal.vault_id). Simulated mode vaults a mock wallet by itself.
CITED_BUYER_VAULT_ID=
# Each seller's PayPal account (the order's payee): a sandbox business account's merchant id,
# or its email. Unset = a mock merchant id, fine in simulated mode only.
CITED_SELLER_NORTHWIND_PAYEE=
CITED_SELLER_LUMEN_PAYEE=
CITED_SELLER_MEGAMART_PAYEE=

# --- LLM gateway (only when MODEL_PROVIDER is not fake) -------------------------------------
# OpenAI-compatible gateway used by the GPT, Gemini and Sonnet shopper agents and the evals.
# apps/agents appends /chat/completions, so include the version path there
# (e.g. https://gateway.example.com/v1). packages/evals appends /v1/chat/completions,
# so give it the host only (e.g. https://gateway.example.com).
LLM_BASE_URL=
LLM_API_KEY=
GPT_MODEL=gpt-5
GEMINI_MODEL=gemini-2.5-pro
SONNET_MODEL=claude-sonnet-5-5

# --- Engine --------------------------------------------------------------------------------
# Bearer token for /api writes on the engine (reads are public). Unset = writes answer 503
# unless ENGINE_OPEN_API=1 (`npm run dev` passes it). Set it in apps/engine/.dev.vars.
ENGINE_API_TOKEN=

# --- Catalogue and ports --------------------------------------------------------------------
# Seed for the deterministic arm assignment.
CATALOGUE_SEED=cited-demo
# Each app listens on its default port. PORT overrides it for whichever single app you start.
# engine 8800, catalogue-mcp 8801, agents 8803, studio 8804, console 8805.
# PORT=
