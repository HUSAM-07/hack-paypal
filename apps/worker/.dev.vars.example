# Copy to .dev.vars (gitignored). Never commit real values.
ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
# 32+ random bytes, e.g. `openssl rand -base64 32`
SESSION_SECRET=
# WebAuthn relying party. Must match the origin the browser loads.
RP_ID=localhost
ORIGINS=http://localhost:5180,http://localhost:5173,http://localhost:8790
# Enables POST /api/auth/dev-login (passwordless test users). Never set in production.
DEV_AUTH=1
# "anthropic" or "fake" (scripted, no network)
MODEL_PROVIDER=anthropic
# "simulated" (no PayPal calls), "sandbox" or "live". Sandbox/live need the three below.
PAYPAL_MODE=simulated
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `npx tsx packages/paypal/spikes/09-webhooks.ts` once PAYPAL_WEBHOOK_URL is set.
PAYPAL_WEBHOOK_ID=
# When set, creating an account needs this code (share /app?invite=<code>). Empty = open.
INVITE_CODE=

# --- CITED engine at /api/cited (src/cited.ts) ---
# PayPal mode for CITED only; falls back to PAYPAL_MODE.
CITED_PAYPAL_MODE=simulated
# Id of the webhook subscribed to <origin>/api/cited/webhooks/paypal.
CITED_PAYPAL_WEBHOOK_ID=
# Same value as the catalogue's PASSPORT_SIGNING_KEY. wrangler.jsonc sets the public dev key.
CITED_PASSPORT_KEY=
# Bearer token for CITED writes (engine write API, catalogue refunds/disputes/demo clock).
# Unset = those writes answer 503. Reads, /try, /mcp and Studio work either way.
CITED_API_TOKEN=
# Local only: 1 opens CITED writes without a token (while CITED_API_TOKEN is unset). Never
# put it in wrangler.jsonc or a worker secret; CI refuses to deploy if wrangler.jsonc has it.
CITED_OPEN_API=1

# --- Live agent at /try (src/live) ---
# An OpenAI-compatible gateway for local runs (base URL ending in /v1). Takes priority over
# ANTHROPIC_API_KEY; with neither set, /try runs the scripted agent and says so on the page.
LLM_BASE_URL=
LLM_API_KEY=
# Model for live runs (default claude-sonnet-5-5).
CITED_LIVE_MODEL=
