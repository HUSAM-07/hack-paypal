# Copy to .dev.vars (gitignored). Never commit real values.
ANTHROPIC_API_KEY=
CHANNEL3_API_KEY=
# 32+ random bytes, e.g. `openssl rand -base64 32`
SESSION_SECRET=
# WebAuthn relying party. Must match the origin the browser loads.
RP_ID=localhost
ORIGINS=http://localhost:5180,http://localhost:5173,http://localhost:8790
# Enables POST /api/auth/dev-login (passwordless test users). Never set in production.
DEV_AUTH=1
# "anthropic" or "fake" (scripted, no network)
MODEL_PROVIDER=anthropic
# "simulated" (no PayPal calls), "sandbox" or "live". Sandbox/live need the three below.
PAYPAL_MODE=simulated
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Printed by `npx tsx packages/paypal/spikes/09-webhooks.ts` once PAYPAL_WEBHOOK_URL is set.
PAYPAL_WEBHOOK_ID=
