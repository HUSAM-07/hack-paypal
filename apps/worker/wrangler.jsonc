{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pact-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Deployed to the team's own Cloudflare account on workers.dev.
  "workers_dev": true,
  // The web app ships with the worker so cookies and sockets stay same-origin. The
  // landing is the prerendered index.html; /app routes get app.html from the worker.
  // No SPA fallback, so a stale chunk 404s instead of returning HTML.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/ws",
      "/app",
      "/app/*",
      "/console",
      "/console/*",
      "/catalogue",
      "/catalogue/*",
      "/studio",
      "/studio/*",
      "/mcp",
      "/try",
      "/try/*",
      "/creators",
      "/creators/*",
      "/shop",
      "/shop/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      { "name": "THREAD", "class_name": "ThreadDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "PACT", "class_name": "PactDO" },
      { "name": "CITED_DEMO", "class_name": "CitedDemoDO" },
      // Shop: one Agents SDK agent per user (apps/shop).
      { "name": "SHOPPER", "class_name": "ShopperAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ThreadDO", "UserDO", "PactDO"] },
    { "tag": "v2", "new_sqlite_classes": ["CitedDemoDO"] },
    { "tag": "v3", "new_sqlite_classes": ["ShopperAgent"] }
  ],
  // Shop checkout: re-verify → authorize → cooling-off → capture or void (apps/shop).
  "workflows": [
    { "name": "pact-shop-checkout", "binding": "CHECKOUT", "class_name": "CheckoutWorkflow" }
  ],
  // KV and R2 have no ids here on purpose: wrangler provisions them in each target's account on
  // its first deploy and keeps them linked after. scripts/deploy.mjs can pin ids per target.
  "kv_namespaces": [{ "binding": "SHOP_CACHE" }],
  "r2_buckets": [{ "binding": "SHOP_FILES" }],
  // Browser Run (shop price extraction, Live View). Workers Free allows 10 browser-minutes a
  // day; the shop needs Workers Paid for real use and degrades to Exa contents without it.
  "browser": { "binding": "BROWSER" },
  // Workers AI (binding AI) is added by scripts/deploy.mjs for deploys only: an AI binding here
  // would make `wrangler dev` and the test pool open a remote session that needs Cloudflare
  // credentials (CI has none). Locally the shop runs without it.
  // Shop reconciliation sweep: missed watch checks, stuck checkouts, authorizations near expiry.
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pact",
      "database_id": "21de0d7d-9197-4260-a7e2-8453b7736e24",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    // Unauthenticated surface (auth endpoints, WS upgrades), keyed by IP.
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Model-spending actions (turn/start, approval/respond), keyed by user.
    { "name": "USER_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "MODEL_PROVIDER": "anthropic",
    "MODEL_ID": "claude-sonnet-5-5",
    "RP_NAME": "Pact",
    // Production origin; .dev.vars overrides both for local dev. Passkeys are bound
    // to RP_ID, so only this host can sign people in.
    "RP_ID": "pact-worker.vincent-wesley-liem.workers.dev",
    "ORIGINS": "https://pact-worker.vincent-wesley-liem.workers.dev",
    "STEP_UP_ABOVE_MINOR": "20000",
    // Simulated until the in-app sandbox checkout is verified with a real buyer login.
    "PAYPAL_MODE": "simulated",
    // CITED engine at /api/cited. The passport key here is the published dev key the catalogue
    // uses in simulated mode (not a secret); a sandbox deployment overrides it with a secret.
    "CITED_PAYPAL_MODE": "simulated",
    // Sandbox subscription for <workers.dev>/api/cited/webhooks/paypal (capture, refund,
    // reversal, dispute and payout-batch events). Not a secret; signatures are bound to it.
    "CITED_PAYPAL_WEBHOOK_ID": "8042373202922840X",
    "CITED_PASSPORT_KEY": "cited-dev-passport-key",
    // Shop (shop/spec/SHOP-SPEC.md). Off: its routes and Google sign-in 404 and the sweep idles.
    "SHOP_ENABLED": "false",
    "AI_GATEWAY_ID": "pact-shop",
    // The team account's id; scripts/deploy.mjs sets each other target's.
    "CF_ACCOUNT_ID": "",
    "SHOP_MODEL_ID": "anthropic/claude-sonnet-5.5",
    "SHOP_COOLING_OFF_MINUTES": "10"
  }
}
