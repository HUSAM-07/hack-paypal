    "@pact/paypal": "*",
    "@pact/policy": "*",
    "@pact/protocol": "*",
    "@simplewebauthn/server": "^14.0.3",
    "ai": "^7.0.159",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261101.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "wrangler": "^4.156.0"
