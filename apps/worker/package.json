  "private": true,
  "type": "module",
  "exports": {
    "./agent": "./src/agent/embed.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8790",
    "build:web": "VITE_PACT_WS_URL=/ws npm run build -w @pact/web",
