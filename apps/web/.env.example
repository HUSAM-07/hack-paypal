# Leave unset to run the in-browser mock server (scripted demo).
# Set to the worker's WebSocket endpoint to talk to the real backend.
VITE_PACT_WS_URL=
# Base URL for REST endpoints (PayPal tokens/orders). Defaults to same origin.
VITE_PACT_API_URL=
# PayPal sandbox *client id* (public). Never put the secret here.
VITE_PAYPAL_CLIENT_ID=
