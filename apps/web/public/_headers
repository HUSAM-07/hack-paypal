# Static-asset headers (Cloudflare Workers assets / Pages). No inline scripts anywhere,
# so script-src needs no 'unsafe-inline' or nonces. Third parties: PayPal, and the
# Cloudflare Web Analytics beacon the zone injects.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://*.paypal.com https://*.paypalobjects.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' wss: https://*.paypal.com https://cloudflareinsights.com; frame-src https://*.paypal.com; base-uri 'none'; object-src 'none'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), publickey-credentials-get=(self)

# Hashed bundles and versioned art/fonts never change under the same URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/art/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
