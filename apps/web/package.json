{
  "name": "@pact/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "VITE_PACT_WS_URL=/ws vite",
    "build": "tsx scripts/gen-proof-data.ts && tsc -p tsconfig.json && vite build && vite build --ssr src/landing/entry-server.tsx --outDir dist-ssr && vite build --ssr src/proof/entry-server.tsx --outDir dist-ssr-proof && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@cited/studio": "*",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@openuidev/react-lang": "^1.0.2",
    "@pact/attribution": "*",
    "@pact/catalog": "*",
    "@pact/policy": "*",
    "@pact/protocol": "*",
    "@paypal/paypal-js": "^11.3.0",
    "@paypal/react-paypal-js": "^10.6.1",
    "@simplewebauthn/browser": "^14.0.0",
    "ag-grid-community": "~36.3.0",
    "ag-grid-enterprise": "~36.3.0",
    "ag-grid-react": "~36.3.0",
    "ag-studio": "^3.1.0",
    "ag-studio-react": "^3.1.0",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
