{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@pact/web"
      ],
      "port": 5180
    },
    {
      "name": "worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@pact/worker"
      ],
      "port": 8790
    },
    {
      "name": "web-live",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:live",
        "-w",
        "@pact/web"
      ],
      "port": 5180
    },
    {
      "name": "shop-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@shop/web"
      ],
      "port": 5181
    },
    {
      "name": "shop-worker",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "-w",
        "@pact/worker",
        "--",
        "wrangler",
        "dev",
        "--port",
        "8795",
        "--var",
        "ORIGINS:http://localhost:8795",
        "--var",
        "SHOP_PUBLIC_ORIGIN:http://localhost:8795"
      ],
      "port": 8795
    }
  ]
}
