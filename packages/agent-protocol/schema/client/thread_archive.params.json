{
  "title": "thread/archive params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "archived": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": ["threadId"]
}
