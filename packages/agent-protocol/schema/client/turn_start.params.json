{
  "title": "turn/start params",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "uiState": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": ["threadId", "text"]
}
