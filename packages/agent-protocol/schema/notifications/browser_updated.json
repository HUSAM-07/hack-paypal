{
  "title": "browser/updated",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session": {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string"
        },
        "title": {
          "default": "",
          "type": "string",
          "maxLength": 300
        },
        "controller": {
          "type": "string",
          "enum": ["agent", "user"]
        },
        "liveViewUrl": {
          "type": "string"
        },
        "screenshotUrl": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        }
      },
      "required": ["sessionId", "url", "title", "controller", "updatedAt"],
      "additionalProperties": false
    }
  },
  "required": ["session"],
  "additionalProperties": false
}
