{
  "title": "item/toolCall/progress",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "itemId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "label": {
      "type": "string",
      "maxLength": 120
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["threadId", "itemId", "label"],
  "additionalProperties": false
}
