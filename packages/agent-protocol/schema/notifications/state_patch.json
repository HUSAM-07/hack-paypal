{
  "title": "state/patch",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "baseVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ops": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": ["add", "remove", "replace", "move", "copy", "test"]
          },
          "path": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "value": {}
        },
        "required": ["op", "path"],
        "additionalProperties": false
      }
    }
  },
  "required": ["version", "baseVersion", "ops"],
  "additionalProperties": false
}
