{"id":"parse-ps6-price-split","title":"PS6 price watch split 3 ways with caps","tags":["parsing","pact"],"world":"group3","turns":[{"userId":"user_alice","text":"Let's get the standard PS6 for the house when it drops below $450 before Friday. Split 3 ways between me, Bob and Carol, max $160 each.","expect":{"tools":{"mustCall":["searchProducts","draftPact"],"mustNotCall":["requestSpend"],"order":[["searchProducts","draftPact"]],"args":{"draftPact":{"members":{"$unordered":[{"userId":"user_alice","cap":{"amountMinor":16000}},{"userId":"user_bob","cap":{"amountMinor":16000}},{"userId":"user_carol","cap":{"amountMinor":16000}}]},"trigger":{"kind":"price","productRef":"product_ps6std01","maxPrice":{"amountMinor":{"$in":[44999,45000]},"currency":"USD"},"deadline":{"$between":["2026-11-05T07:00:00Z","2026-11-07T08:00:00Z"]}},"action":{"kind":"purchase","productRef":"product_ps6std01","quantity":1},"split":{"kind":"equal"}}}},"ui":{"mustInclude":["PactCard"]}}}],"fixtures":{"pacts":[]},"judge":{"rubric":"helpfulness","criteria":"The agent should draft the pact and show it, and say that Bob and Carol still need to commit. It should not claim anything was bought."}}
{"id":"parse-coffee-every-3-weeks","title":"Standing order every 3 weeks","tags":["parsing","pact","schedule"],"world":"group3","turns":[{"userId":"user_bob","text":"Set up a standing order: every 3 weeks buy the Stumptown coffee beans for the house, split equally between all three of us, cap $10 each.","expect":{"tools":{"mustCall":["draftPact"],"mustNotCall":["requestSpend"],"args":{"draftPact":{"members":{"$unordered":[{"userId":"user_alice","cap":{"amountMinor":1000}},{"userId":"user_bob","cap":{"amountMinor":1000}},{"userId":"user_carol","cap":{"amountMinor":1000}}]},"trigger":{"kind":"schedule","everyDays":21},"action":{"kind":"purchase","productRef":"product_coffee01","quantity":1},"split":{"kind":"equal"}}}},"ui":{"mustInclude":["PactCard"]}}}]}
{"id":"parse-every-4-weeks-paper","title":"Standing order every 4 weeks","tags":["parsing","pact","schedule"],"world":"group3","turns":[{"userId":"user_carol","text":"Every 4 weeks get a pack of paper towels for the apartment. Split it between all of us, max $8 each.","expect":{"tools":{"mustCall":["draftPact"],"mustNotCall":["requestSpend"],"args":{"draftPact":{"members":{"$unordered":[{"userId":"user_alice","cap":{"amountMinor":800}},{"userId":"user_bob","cap":{"amountMinor":800}},{"userId":"user_carol","cap":{"amountMinor":800}}]},"trigger":{"kind":"schedule","everyDays":28},"action":{"kind":"purchase","productRef":"product_paper001","quantity":1}}}},"ui":{"anyOf":["PactCard","ScheduleCard"]}}}]}
