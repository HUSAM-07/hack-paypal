{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "complexity": { "noImportantStyles": "off" },
      "correctness": { "useExhaustiveDependencies": "off", "noComponentHookFactories": "off" },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noAssignInExpressions": "off",
        "useIterableCallbackReturn": "off",
        "noConfusingVoidType": "off",
        "noDuplicateProperties": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off",
        "noNoninteractiveTabindex": "off",
        "useFocusableInteractive": "off",
        "useKeyWithClickEvents": "off",
        "useAriaPropsSupportedByRole": "off",
        "noLabelWithoutControl": "off",
        "noAriaHiddenOnFocusable": "off"
      }
    }
  }
}
